# TableTalk voice agent - environment variables
# Copy to .env and fill in the values. Never commit the .env file.

# --- Server ---------------------------------------------------------------
# TCP port the HTTP/WebSocket server listens on (Render/Railway inject PORT).
PORT=8080
# Public https URL of THIS service, with no trailing slash, e.g. https://abc123.ngrok-free.app
# Used to build the Telnyx media stream URL (wss://.../telnyx/media).
PUBLIC_BASE_URL=
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Telnyx ---------------------------------------------------------------
# API key (v2) from Mission Control > Auth > API Keys.
TELNYX_API_KEY=
# Base64 Ed25519 public key from Mission Control > Auth > Public Key, used to
# verify webhook signatures.
TELNYX_PUBLIC_KEY=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# Chat model used by the LangChain booking agent (when LLM_PROVIDER=openai).
OPENAI_CHAT_MODEL=gpt-4o-mini
# Speech-to-text model (gpt-4o-mini-transcribe, gpt-4o-transcribe or whisper-1).
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Text-to-speech model (gpt-4o-mini-tts, tts-1 or tts-1-hd) and voice.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- LLM provider ---------------------------------------------------------
# openai | google | xai. Only openai is installed; see README "Swapping the LLM".
LLM_PROVIDER=openai

# --- MongoDB --------------------------------------------------------------
# Connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
# Database name.
MONGODB_DB=tabletalk

# --- Restaurant -----------------------------------------------------------
# Name spoken in the greeting and used in the agent prompt.
RESTAURANT_NAME=TableTalk
# IANA time zone the restaurant operates in (used for "today", "tomorrow", past-slot checks).
RESTAURANT_TIMEZONE=Europe/London
# Opening hours (24h). Slots start on the hour from OPEN_HOUR; last slot starts at CLOSE_HOUR-1.
OPEN_HOUR=11
CLOSE_HOUR=23
# Tables available in every one-hour slot.
TOTAL_TABLES=10
