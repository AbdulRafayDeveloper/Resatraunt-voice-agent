{
  "name": "tabletalk-voice-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Always-on voice booking agent for TableTalk: Telnyx call audio in, OpenAI speech and a LangChain agent in the middle, bookings saved to MongoDB.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@langchain/core": "^1.2.18",
    "@langchain/openai": "~1.5.8",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "openai": "^6.41.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12"
  }
}
