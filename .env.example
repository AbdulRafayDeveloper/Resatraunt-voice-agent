# Canonical production origin, the single source of truth for canonical links, sitemap, robots,
# Open Graph, Twitter and JSON-LD URLs. Set it in Vercel (Production) to the final domain with no
# trailing slash, e.g. https://tabletalk.example. When unset: Vercel production uses the project URL,
# preview deployments use their own URL (and are marked noindex), local development uses localhost.
NEXT_PUBLIC_SITE_URL=https://example.com

# Public contact email shown on the site and used in mailto: links. Defaults to a reserved
# .example placeholder (clearly labelled on the site) until the real inbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional. WhatsApp number in international format without "+" (e.g. 447700900000).
# WhatsApp links are hidden everywhere when this is empty; no number is ever invented.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. Instagram profile URL; the footer link and Organization sameAs are hidden when empty.
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional. Google Search Console HTML-tag verification token (the content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional. When set, the server action forwards every validated submission (table requests,
# listing enquiries, contact messages, newsletter sign-ups) to this HTTPS endpoint as JSON
# (e.g. a Zapier/Make hook, a Google Sheets webhook or a CRM). Leave empty to run without a
# backend; visitors still receive a reference number. Nothing here confirms a booking.
REQUEST_WEBHOOK_URL=
